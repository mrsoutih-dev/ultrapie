# Ultrapie Local Environment Configuration

# Database
DATABASE_URL="postgresql://ultrapie:ultrapie_dev_secret@localhost:5432/ultrapie_dev?schema=public"
POSTGRES_USER=ultrapie
POSTGRES_PASSWORD=ultrapie_dev_secret
POSTGRES_DB=ultrapie_dev

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# API & Web Ports
PORT=4000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# AI Gateway (Google Gemini)
GEMINI_API_KEY=""

# Coolify Self-Hosted VPS
COOLIFY_URL="http://127.0.0.1:8000"
COOLIFY_TOKEN=""

# Security & Secrets
JWT_SECRET="ultrapie-dev-insecure-secret-key-change-in-prod"
COOKIE_SECRET="ultrapie-dev-cookie-secret-key"

# Storage (Cloudflare R2 & Media CDN)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PRIVATE="ultrapie-private-sources"
R2_BUCKET_PUBLIC="ultrapie-media"
R2_BUCKET_RELEASES="ultrapie-releases"
R2_PUBLIC_DOMAIN="https://media.ultrapie.com"
NEXT_PUBLIC_CDN_URL="https://media.ultrapie.com"
